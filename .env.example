# Copy this file to .env.local and fill in real values.
# Next.js does not load .env.example.

# Application URL (include https:// in production, http://localhost:3000 locally)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAIN_DOMAIN=example.com
NEXT_PUBLIC_MAIN_DOMAIN=example.com

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Named Firestore DB id (required when the project has no "(default)" database)
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Comma-separated emails that receive the admin role in addition to Firestore users.role == "admin"
ADMIN_EMAILS=admin@example.com

# Firebase Admin (server only). Use a real service-account private key with \n line breaks.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=
# Vercel API (server only)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# GitHub OAuth (server only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/callback
# Optional. Falls back to GITHUB_CLIENT_SECRET when unset.
OAUTH_STATE_SECRET=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
