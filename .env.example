# ==============================================================================
# PUBLIC ENVIRONMENT VARIABLES (Exposed to browser via NEXT_PUBLIC_*)
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Client Configuration (matches firebase-applet-config.json)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Razorpay Public Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ==============================================================================
# SERVER ONLY ENVIRONMENT VARIABLES (NEVER exposed to the browser)
# ==============================================================================

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Firebase Admin SDK Configuration (Server-Side)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Vercel Deployment & Domain API Integration
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# GitHub OAuth Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL=""

# Razorpay Server Secrets & Webhooks
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary Integration (Server-Side)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
